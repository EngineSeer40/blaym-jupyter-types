          "type": "string"
        },
        "executionId": {
          "type": "string"
        },
        "langgraph": {
          "$ref": "#/definitions/BlaymEventCausalLangGraph"
        },
        "sourceRevision": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "BlaymEventCausalLangGraph": {
      "additionalProperties": false,
      "properties": {
        "checkpointId": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId"
      ],
      "type": "object"
    }
  },
  "properties": {
    "branchId": {
      "type": "string"
    },
    "causal": {
      "$ref": "#/definitions/BlaymEventCausal"
    },
    "eventId": {
      "format": "uuid",
      "type": "string"
    },
    "explorationId": {
      "type": "string"
    },
    "originId": {
      "type": "string"
    },
    "payload": {
      "additionalProperties": {},
      "type": "object"
    },
    "schemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "seq": {
      "minimum": 1,
      "type": "integer"
    },
    "type": {
      "type": "string"
    },
    "wallTimeMs": {
      "minimum": 0,
      "type": "integer"
    }
